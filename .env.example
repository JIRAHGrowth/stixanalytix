# Copy to .env.local and fill in. Never commit .env.local.

# ============================================================================
# Supabase (Next.js app + video worker both use these)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://lmwbvkyqyhagqegewnyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Gemini (video worker)
# ============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# Error tracking — D3 pending, placeholder
# ============================================================================
# SENTRY_DSN=

# ============================================================================
# Modal credentials live in ~/.modal.toml after `python -m modal setup`.
# The worker itself reads Supabase + Gemini keys from the "stix-env" Modal
# secret, not from this file. See worker/README.md.
#
# These two are needed by the Next.js /api/video-jobs route to trigger the
# worker after a coach submits the upload form. Both are printed / generated
# when you run `modal deploy worker/app.py`.
# ============================================================================
MODAL_TRIGGER_URL=
MODAL_TRIGGER_SECRET=

# Trigger URL for backfill_clips_from_events. Also printed by `modal deploy
# worker/app.py`. Called by app/api/video-jobs/[id]/publish/route.js as
# fire-and-forget after a match commits, so coach-added / coach-edited
# events get a fresh clip whose timestamp matches the persisted event row.
# Same X-Trigger-Secret as MODAL_TRIGGER_SECRET.
MODAL_BACKFILL_CLIPS_TRIGGER_URL=

# ============================================================================
# Stixanalytix data root (OneDrive workspace, separate from this codebase).
# Test scripts and pipelines resolve match videos, training data, and report
# templates relative to this path. When Stixanalytix incorporates and the data
# folder moves to its own SharePoint tenant, update this one line.
# ============================================================================
STIXANALYTIX_DATA_ROOT=C:\\Users\\joshu\\OneDrive\\Stixanalytix
